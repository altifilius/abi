# Example environment variables for local development
# Copy to `.env.local` and set real values before running the app

# API key for the LLM or model provider (do not commit real keys)
GEMINI_API_KEY=

# Node / app settings
NODE_ENV=development
PORT=5173

# Optional: base URL for any backend/API the frontend talks to
VITE_API_URL=http://localhost:3000

# Template/versioning reference used in reports
TEMPLATE_VERSION=1.0.0

# Logging level (debug | info | warn | error)
LOG_LEVEL=info
