# Same-origin production API; backend loopback port is consistently 8001.
VITE_API_BASE=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8001
VITE_DEV_HOST=127.0.0.1

# Used only by compose.yml for a fresh PostgreSQL volume; not a frontend variable.
# ABI_DATABASE_PASSWORD=choose-a-strong-private-password
