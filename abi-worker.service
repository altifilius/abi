[Unit]
Description=Abi notification and reminder worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emre/Projects/abi
ExecStart=/home/emre/Projects/abi/.venv-menu/bin/python -m backend.reminders --interval 60
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
