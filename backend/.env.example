DATABASE_URL=postgresql+asyncpg://abi_upgrade:CHANGE_ME@127.0.0.1:15472/abi_upgrade
HOST=127.0.0.1
PORT=8001
RELOAD=false
PUBLIC_APP_URL=http://127.0.0.1:8001
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:8001,http://localhost:8001,http://127.0.0.1:3000,http://localhost:3000
MAX_REQUEST_BYTES=262144
MAX_UPLOAD_BYTES=20971520

# External AI is optional. Credentials stay server-side; workspace policy controls use.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_IDEA_MODEL=gpt-4o-mini
OPENAI_FUND_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Explicit private, self-hosted OpenAI-compatible endpoint. No external fallback.
LOCAL_AI_BASE_URL=http://127.0.0.1:11435/v1
LOCAL_AI_API_KEY=ollama-local
LOCAL_AI_CHAT_MODEL=qwen3:1.7b
LOCAL_AI_IDEA_MODEL=qwen3:1.7b
LOCAL_AI_EMBEDDING_MODEL=embeddinggemma
# Ollama-specific, explicit provider option; leave empty for other providers.
LOCAL_AI_REASONING_EFFORT=none
AI_REQUEST_TIMEOUT_SECONDS=180
AI_MAX_CONTEXT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=2048
DEFAULT_REPORT_ID=default_report

# Local Mailpit development delivery. Production requires authenticated TLS SMTP.
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
SMTP_FROM_EMAIL=abi@localhost
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=20

# Private content must never be served as static files.
# STORAGE_ROOT=/absolute/path/private-documents
# PDF_FONT_PATH=/usr/share/fonts/TTF/DejaVuSans.ttf
# PDF_BOLD_FONT_PATH=/usr/share/fonts/TTF/DejaVuSans-Bold.ttf
# OCR_DATA_PATH=/absolute/path/tessdata
OCR_LANGUAGE=tur+eng
OCR_TIMEOUT_SECONDS=60
